{
  "name": "craf7ton-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Craf7ton storefront, admin and API (Vercel)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev-server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --env-file-if-exists=.env.test --test --test-concurrency=1 tests/*.test.js",
    "vercel-build": "node scripts/vercel-build.js"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.1",
    "pg": "^8.23.1"
  }
}
