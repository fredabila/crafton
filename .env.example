# Copy to .env for local development. On Vercel, set these in Project Settings -> Environment Variables.

# Postgres. On Vercel, add Neon from the Marketplace (Storage tab) and this is set for you.
DATABASE_URL=postgres://crafton:crafton@localhost:5432/crafton

# Public site URL, used for payment callbacks and links in emails/SMS.
SITE_URL=http://localhost:3000

# Admin dashboard (/admin). Use a long password and a random 32+ character secret.
ADMIN_PASSWORD=change-me-to-something-long
SESSION_SECRET=generate-with-openssl-rand-hex-32-xxxxxxxxxxxxxxxx

# Paystack (Mobile Money + cards). Leave empty to run "order on WhatsApp, pay MoMo manually" mode.
# Set the webhook URL in the Paystack dashboard to https://YOUR-DOMAIN/api/paystack/webhook
PAYSTACK_SECRET_KEY=
# Paystack needs an email; customers without one get <phone>@this-domain on the receipt.
PAYSTACK_PLACEHOLDER_EMAIL_DOMAIN=customers.craf7ton.com

# Product image uploads. On Vercel, create a Blob store (Storage tab) and this is set for you.
BLOB_READ_WRITE_TOKEN=

# Email notifications via Resend (https://resend.com). Verify your sending domain first.
RESEND_API_KEY=
MAIL_FROM=Craf7ton <orders@craf7ton.com>
STORE_EMAIL=hello@craf7ton.com

# SMS notifications via Arkesel (https://arkesel.com). Sender ID max 11 chars, must be approved.
ARKESEL_API_KEY=
SMS_SENDER=Craf7ton
STORE_PHONE=233000000000

# Vercel Cron auth (expires unpaid orders daily). Any random string.
CRON_SECRET=
